# ========================================================
# OFFERPATH – ENVIRONMENT CONFIGURATION EXAMPLE
# ========================================================
# Copy this file to .env in your root and/or backend folder:
# cp .env.example .env (or copy .env.example .env on Windows)

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=offerpath-super-secret-key-change-in-production-2026

# Database Configuration (PostgreSQL by default)
# Format: postgresql://username:password@localhost:5432/database_name
# Example for default local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/offerpath

# Optional: If you want to use SQLite for rapid zero-setup testing without PostgreSQL:
# DATABASE_URL=sqlite:///offerpath.db

# Google Gemini API Key for AI Interview Question Generator
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Authentication
JWT_SECRET_KEY=offerpath-jwt-secret-key-change-in-production
JWT_EXPIRATION_HOURS=72

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=5242880
